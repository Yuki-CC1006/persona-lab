# DeepSeek OpenAI-compatible API (candidate extraction / Q&A)
# Create a key at https://platform.deepseek.com/api_keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# Default model; switch it on the settings page, no need to edit this
# Options: deepseek-v4-flash / deepseek-v4-flash-think / deepseek-v4-pro / deepseek-v4-pro-think
LLM_MODEL=deepseek-v4-flash

# Local embedding is built in (bag-of-words hashing); a remote one is usually unnecessary
# If configured, compare with `uv run python scripts/quality_baseline.py` before switching
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Privacy
REDACTION_ENABLED=true
BIND_HOST=127.0.0.1
BIND_PORT=8765

# Storage
DATABASE_URL=sqlite:///./data/persona_lab.db
UPLOAD_DIR=./data/uploads
# Encrypted backup directory and retention count (older ones are pruned)
BACKUP_DIR=./data/backups
BACKUP_KEEP=5
